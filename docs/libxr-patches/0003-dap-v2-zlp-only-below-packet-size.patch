+    // stalls the command stream under a deep pipeline.
+    const bool need_zlp = (mps != 0U) && (response.len % mps == 0U) &&
+                          (response.len < GetDapPacketSize());
     if (ep_data_in_->Write({response.payload, response.len}, need_zlp, in_isr) ==
         ErrorCode::OK)
     {
