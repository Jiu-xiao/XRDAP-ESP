commit e816f4392768cc340108c6f47361de9048f42187
Author: Xiao <Cong.Liu_Xiao@outlook.com>
Date:   Sat Jul 4 00:21:42 2026 +0100

    fix(swd): add trailing idle clocks after write data phase
    
    The SWD write data phase ended immediately after clocking the parity
    bit (SWDIO high, SWCLK low) with no trailing clocks. Because an AP
    write is posted, the target could still be completing the write when
    the next transaction's start bit was clocked, so a transfer issued
    immediately after an AP write within the same batched DAP_Transfer
    sampled its ACK at the wrong phase and read it as an invalid value
    (reported by OpenOCD as "SWD ack not OK @ N JUNK").
    
    This surfaced as cortex_m examine failing with "Cannot detect cache"
    on an STM32F302CB (Cortex-M4) target: single-transfer reads (CPUID,
    MVFR0, DHCSR) succeeded, but the batched cache/DWT/FPB reads that
    follow an AP write failed on the second transfer. Driving each
    transaction in its own USB packet (e.g. manual `dap apreg`) masked the
    bug because inter-packet latency gave the posted write time to settle.
    
    Fix: after the write parity bit, drive SWDIO low and clock
    WRITE_TRAILING_IDLE_CLOCKS idle cycles, in both the delayed and
    non-delayed transfer paths, so the target settles the write before the
    next start bit.
    
    Hardware threshold sweep (STM32F103 CMSIS-DAP probe -> STM32F302CB,
    rebuild+flash+examine each): 0 and 1 trailing clocks still fail; 2 is
    the minimum that passes. The constant is set to 3 (minimum + margin).
    
    Throughput impact is negligible: a 32 KiB block SRAM write took 771 ms
    versus 755 ms for the equivalent read (whose path is unchanged), i.e.
    throughput is dominated by USB round-trips, not SWD clock time; the
    few extra write-phase clocks are lost in the noise.
    
    Verified on hardware: OpenOCD examine now succeeds, the full
    ROM-table/DWT/FPB walk completes, reset halt works, and high-level
    memory write+read verify is byte-exact. Manual MEM-AP access is
    unaffected.

diff --git a/src/driver/debug/swd_general_gpio.hpp b/src/driver/debug/swd_general_gpio.hpp
index 026b7f15..7b661442 100644
--- a/src/driver/debug/swd_general_gpio.hpp
+++ b/src/driver/debug/swd_general_gpio.hpp
@@ -568,6 +568,16 @@ class SwdGeneralGPIO final : public Swd
       const bool PARITY_BIT = (Parity32(DATA) & 0x1u) != 0u;
       WriteBit(PARITY_BIT);
 
+      // Trailing idle clocks after a write data phase: keep SWDIO driven LOW and
+      // clock the target so it completes/settles the (possibly posted) write before
+      // the next request start bit. Without this, a transfer immediately following an
+      // AP write in the same DAP_Transfer batch samples ACK at the wrong phase (JUNK).
+      swdio_.Write(false);
+      for (uint32_t k = 0; k < WRITE_TRAILING_IDLE_CLOCKS; ++k)
+      {
+        GenOneClk();
+      }
+
       swdio_.Write(true);
       swclk_.Write(false);
     }
@@ -645,6 +655,13 @@ class SwdGeneralGPIO final : public Swd
       const bool PARITY_BIT = (Parity32(DATA) & 0x1u) != 0u;
       WriteBitWithoutDelay(PARITY_BIT);
 
+      // Trailing idle clocks after a write data phase (see delay-path note).
+      swdio_.Write(false);
+      for (uint32_t k = 0; k < WRITE_TRAILING_IDLE_CLOCKS; ++k)
+      {
+        GenOneClkWithoutDelay();
+      }
+
       swdio_.Write(true);
       swclk_.Write(false);
     }
@@ -659,6 +676,8 @@ class SwdGeneralGPIO final : public Swd
       64u;  ///< 线复位时钟周期数。Line reset clock cycles.
   static constexpr uint32_t BYTE_BITS = 8u;  ///< 每字节比特数。Bits per byte.
   static constexpr uint32_t ACK_BITS = 3u;   ///< ACK 比特数。ACK bits.
+  static constexpr uint32_t WRITE_TRAILING_IDLE_CLOCKS =
+      3u;  ///< Idle clocks (SWDIO low) after a write data phase to settle posted writes.
 
   static constexpr uint8_t JTAG_TO_SWD_SEQ0 =
       0x9Eu;  ///< JTAG->SWD 序列字节 0。JTAG-to-SWD sequence byte 0.
