# ESP32-S3 专有：Wi-Fi 和 lwIP 固定在核 0，SWD、DAP、采样在核 1；缓存大小；加大的 Wi-Fi 缓冲。
# ESP32-S3 only: Wi-Fi and lwIP pinned to core 0, SWD, DAP and sampling on core 1; cache
# sizes; larger Wi-Fi buffers.
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
# 32 KB 指令缓存 / 32 KB 数据缓存（64 KB 数据缓存要多占 32 KB 内部 RAM，堆不够时 lwIP 发包会卡住）
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_32KB=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
# 参考 ESP-IDF 的 examples/wifi/iperf（S3）：更大的块确认窗口、更大的 lwIP 邮箱，lwIP 任务优先级与 Wi-Fi 任务相同
CONFIG_ESP_WIFI_TX_BA_WIN=32
CONFIG_ESP_WIFI_RX_BA_WIN=32
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_TASK_PRIO=23
# 核 1 专门跑 SWD：短周期采样时空闲任务很少能运行，不把它算作看门狗超时
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# 加大无线收发队列，减少突发流量时的丢包：Wi-Fi 静态/动态接收缓冲、动态发送缓冲、TCP 窗口和发送缓冲
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=24
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=128
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=128
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=8
