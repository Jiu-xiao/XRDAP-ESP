# ESP32-S2 板（单核，S2FH4：芯片内 4 MB Flash，没有 PSRAM，不开 PSRAM）。所有任务都在核 0；
# 采样任务优先级高于 lwIP，靠 XRDAP-Core 每帧之后留给别的任务的时间不饿死它们。
# The ESP32-S2 board (single core, S2FH4: 4 MB flash in the package, no PSRAM, PSRAM
# stays off). Every task runs on core 0; the sampling task is above lwIP and relies on
# the gap XRDAP-Core leaves after each frame so the others are not starved.
CONFIG_XRDAP_BOARD_S2=y
# 任务看门狗检查空闲任务（panic 见 sdkconfig.defaults）：采样每个周期都让出时间 / The
# task watchdog checks the idle task (panic: see sdkconfig.defaults); sampling yields every
# period.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y

# 内部 RAM 只有 320 KB（IRAM 和 DRAM 共用）：lwIP、Wi-Fi 的代码留在 Flash，不占 IRAM /
# Only 320 KB of internal RAM, shared by IRAM and DRAM: lwIP and Wi-Fi code stays in flash
# instead of IRAM.
CONFIG_LWIP_IRAM_OPTIMIZATION=n
CONFIG_LWIP_EXTRA_IRAM_OPTIMIZATION=n
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# FreeRTOS、堆、环形缓冲的函数也留在 Flash / FreeRTOS, heap and ring-buffer functions stay in
# flash too.
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
# Wi-Fi 缓冲取小：静态接收 4 个（启动时就从堆里分配，按估算 6 个时开机后的堆不到 20 KB），
# 动态收发各 16 个，块确认窗口 4 / Smaller Wi-Fi buffers: 4 static RX buffers (taken from
# the heap at start-up; with 6 the estimated heap after start-up is below 20 KB), 16
# dynamic RX and TX each, block-ack windows of 4.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=4
CONFIG_ESP_WIFI_TX_BA_WIN=4
# 指令缓存 16 KB（默认 8 KB，多占 8 KB 内部 RAM）：采样与 Wi-Fi、lwIP 共用缓存，在 S3 上
# 模拟 S2 实测，缓存加大一档后跳拍明显减少 / 16 KB instruction cache (default 8 KB, 8 KB
# more internal RAM): sampling shares the cache with Wi-Fi and lwIP; on an S3 simulating
# the S2, one cache step up clearly reduced skipped ticks.
CONFIG_ESP32S2_INSTRUCTION_CACHE_16KB=y
# S2 没有日志输出口（控制台关闭），日志、错误码名字和 panic 打印没人能看到；去掉后堆多约
# 2.9 KB、镜像小约 65 KB（map 实测）。复位原因仍由 esp_reset_reason 给出（wifi status）/
# The S2 has no log output (console off), so logs, error names and panic text are never
# seen; dropping them frees about 2.9 KB of heap and about 65 KB of flash (measured from the
# map). The reset reason still comes from esp_reset_reason (wifi status).
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT=y
CONFIG_ESP_ERR_TO_NAME_LOOKUP=n
CONFIG_ESP_SYSTEM_PANIC_SILENT_REBOOT=y
CONFIG_ESP_EVENT_POST_FROM_IRAM_ISR=n
CONFIG_ESP_NETIF_REPORT_DATA_TRAFFIC=n
