menu "XR-DAP"

    choice XRDAP_BOARD
        prompt "Board"
        default XRDAP_BOARD_S2 if IDF_TARGET_ESP32S2
        default XRDAP_BOARD_DEFAULT
        help
            Pin assignment of the build. See firmware/esp32sx/main/config.hpp.

        config XRDAP_BOARD_DEFAULT
            bool "ESP32-S3 dev board: SWCLK GPIO5, SWDIO GPIO4, serial link on UART0"
            depends on IDF_TARGET_ESP32S3

        config XRDAP_BOARD_LITE
            bool "Wireless DAP Lite: SWCLK GPIO37, SWDIO GPIO47 through an SGM3157, no USB-UART"
            depends on IDF_TARGET_ESP32S3

        config XRDAP_BOARD_S2
            bool "ESP32-S2 board: SWCLK GPIO37, SWDIO GPIO35, nRESET GPIO40, no USB-UART"
            depends on IDF_TARGET_ESP32S2
    endchoice

    choice XRDAP_S2_PROFILE
        prompt "ESP32-S2 bring-up profile"
        depends on IDF_TARGET_ESP32S2
        default XRDAP_S2_PROFILE_NORMAL
        help
            Use a separate build directory and SDKCONFIG for each profile. Diagnostic
            profiles require their matching sdkconfig.defaults.s2-* overlay; see
            docs/s2-bringup.md. They do not change the normal S3 build.

        config XRDAP_S2_PROFILE_NORMAL
            bool "Normal: USB DAP + CDC and Wi-Fi"

        config XRDAP_S2_PROFILE_BOOT_DIAG
            bool "Boot diagnostics: full application with header UART logs"

        config XRDAP_S2_PROFILE_UART_DAP
            bool "UART DAP: header UART only, no USB or network"

        config XRDAP_S2_PROFILE_CDC_ONLY
            bool "CDC only: USB CDC and header UART logs, no SWD or network"
    endchoice

    config XRDAP_VERSION_SUFFIX
        string "Firmware version suffix"
        default "-preview-boot-diag" if XRDAP_S2_PROFILE_BOOT_DIAG
        default "-preview-uart-dap" if XRDAP_S2_PROFILE_UART_DAP
        default "-preview-cdc-only" if XRDAP_S2_PROFILE_CDC_ONLY
        default "-preview" if XRDAP_BOARD_S2
        default ""
        help
            Appended to the firmware version in DAP_Info and mDNS. Boards not yet
            tested on hardware use "-preview".

endmenu
