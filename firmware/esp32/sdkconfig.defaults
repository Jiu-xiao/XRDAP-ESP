CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_CHECK_MUTEX_GIVEN_BY_OWNER=n
CONFIG_FREERTOS_INTERRUPT_BACKTRACE=n
CONFIG_FREERTOS_ENABLE_TASK_SNAPSHOT=n
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# UART0 接板上的 USB 转串口芯片，给 DAP 链路和命令行用（libxr 的 UART 驱动），控制台输出
# 不能走这个口（否则日志混进 DAP 帧），系统日志控制台关闭。
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# 核 1 只跑采样任务，短周期采样时它的空闲任务很少能运行，不检查。核 0 不跑采样，空闲任务
# 总能运行；它 5 秒没运行说明核 0 被占死（Wi-Fi、串口都停），看门狗触发 panic 并重启，
# 复位原因为看门狗，而不是静默卡死（没有日志控制台，只报警不重启的话看不到）。
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_ESP_TASK_WDT_PANIC=y
# Wi-Fi、lwIP、串口 DAP 和网络服务在核 0，采样任务独占核 1
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

# 关掉用不到的功能：只用 Wi-Fi STA、IPv4、TCP 客户端连入
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n
CONFIG_ESP_WIFI_ENABLE_SAE_PK=n
CONFIG_ESP_WIFI_GMAC_SUPPORT=n
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_BT_ENABLED=n
CONFIG_LWIP_IPV6=n
CONFIG_LWIP_DHCPS=n
CONFIG_LWIP_NETIF_LOOPBACK=n
CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES=n
CONFIG_LWIP_MAX_SOCKETS=4
CONFIG_LWIP_MAX_ACTIVE_TCP=8
CONFIG_LWIP_MAX_LISTENING_TCP=4
# DAP 一问一答，包不超过 1 KB，TCP 缓冲用 16 KB 足够；Wi-Fi 收发缓冲用 IDF 默认值。
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_LWIP_TCP_WND_DEFAULT=16384

# 传统 ESP32 的 IRAM 比 S3 小：SWD、采样的热路径要放进 IRAM，Wi-Fi 接收路径改回 Flash 执行
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# 命令行 heap 命令要列出各任务栈的最高水位（uxTaskGetSystemState）/ The console's heap
# command lists each task's stack high-water mark (uxTaskGetSystemState).
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
