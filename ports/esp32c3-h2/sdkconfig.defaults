# ESP32-C3 和 ESP32-H2 共用的配置。芯片相关的在 sdkconfig.defaults.<芯片> 里。
# 两块开发板（ESP32-C3-DevKitM-1、ESP32-H2-DevKitM-1）的模组都是 4 MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_CHECK_MUTEX_GIVEN_BY_OWNER=n
CONFIG_FREERTOS_INTERRUPT_BACKTRACE=n
CONFIG_FREERTOS_ENABLE_TASK_SNAPSHOT=n
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# 串口 DAP 链路占用 USB Serial/JTAG，任何控制台输出都不能走它（否则日志混进 DAP 帧）。
# 主控制台在各芯片的配置里定（C3 关闭，H2 用 UART0），第二控制台一律关掉。
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# 单核：采样周期短时采样任务一直忙等，空闲任务得不到运行，不能把它算作看门狗超时。
# 看门狗本身保留（中断看门狗照常工作）。
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
